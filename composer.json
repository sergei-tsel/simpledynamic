{
    "name": "sergei-tsel/simpledynamic",
    "type": "project",
    "description": "The skeleton application for the Simpledynamic framework.",
    "keywords": ["simple", "dynamic", "framework"],
    "license": "MIT",
    "require-dev": {
        "vimeo/psalm": "^6.0.0",
        "symplify/easy-coding-standard": "^13.0.0",
        "rector/rector": "^2.0.0"
    },
    "require": {
        "php": "^8.4",
        "ext-simplexml": "*",
        "ext-yaml": "*",
        "ext-mbstring": "*",
        "illuminate/database": "^v12.11.0",
        "doctrine/mongodb-odm": "^2.7",
        "twig/twig": "^3.14",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "config\\": "config/"
        }
    }
